{
  "routes": [
    {
      "routePath": "/api/:path*",
      "mountPath": "/api",
      "method": "",
      "module": [
        "api/[[path]].js:onRequest"
      ]
    },
    {
      "routePath": "/:path*",
      "mountPath": "/",
      "method": "",
      "module": [
        "[[path]].js:onRequest"
      ]
    }
  ],
  "baseURL": "/"
}